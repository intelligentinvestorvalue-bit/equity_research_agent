# Optional overrides (copy to .env)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3
# OLLAMA_PLANNER=0
# SEC_USER_AGENT=YourName you@example.com
# HOST=0.0.0.0
# PORT=8000
# ACCESS_PIN=

# Keep-alive (Task Scheduler: .\scripts\install_ensure_online.ps1)
# Set to 1 to keep only the local app up and skip Cloudflare while the tunnel is flaky.
# ENSURE_SKIP_TUNNEL=1

# Auto-publish completed research to GitHub (rebuild docs/ + git push)
# Install once: .\scripts\install_publish_sync.ps1
# On job complete the app writes data/publish_requested; the scheduled task pushes.
# PUBLISH_SYNC=1   # reserved; publish is driven by the scheduled task + flag file

# Remote access: ntfy phone push when Cloudflare tunnel URL changes
# Use the same topic as PodSnip if you want one phone subscription for all apps.
# Phone app: ntfy by Philipp C. Heckel only (see CLOUDFLARE_TUNNEL.md)
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Queue start prompts (laptop ntfy — no browser needed with keep-alive)
# QUEUE_NTFY_ENABLED=1
# QUEUE_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Falls back to data/tunnel_url.txt then localhost:8000
